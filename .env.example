# Copie este arquivo para ".env" e preencha com as chaves do seu projeto Firebase.
# Veja docs/agents/firebase-setup.md para o passo a passo completo no console do Firebase.
# Nenhum destes valores é secreto no sentido de chave de servidor (são as chaves
# públicas de configuração do client Firebase), mas mesmo assim não commitamos o .env
# real porque ele é específico do seu projeto.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Necessário só para o login com Google (ver docs/agents/firebase-setup.md, passo 4).
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=
