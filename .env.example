# Copy this file to ".env" and fill in the keys from your Firebase project.
# See docs/agents/firebase-setup.md for the full step-by-step in the Firebase console.
# None of these values are secret in the sense of a server key (they're the
# public config keys for the Firebase client), but we still don't commit the
# real .env because it's specific to your project.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
